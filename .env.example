# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://dhatlrzrtspkeumjxvmk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL ของเว็บที่ deploy แล้ว (ใช้แสดง webhook URL ในหน้าตั้งค่า)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- ความปลอดภัยของ API ----
# Vercel Cron ส่ง Authorization: Bearer <CRON_SECRET> มาที่ /api/dialer/tick
CRON_SECRET=change-me
# คีย์สำหรับระบบภายนอก (n8n / Make / Zapier) ส่งลีดเข้า /api/leads/ingest
INGEST_API_KEY=change-me

# ---- Vapi (ใส่ทีหลังได้ ระหว่างนี้ใช้โหมดจำลอง) ----
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
USD_TO_THB=36

# ---- LINE Messaging API (ไม่บังคับ) แจ้งแอดมินเมื่อเจ้าของยอมรับดูโปรไฟล์ ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=

# ---- เชื่อม VPS (ระบบทรัพย์) ----
# endpoint ที่ dev ฝั่ง VPS สร้างไว้รับผลการโทร และ secret ที่ใช้เซ็น HMAC
VPS_WEBHOOK_URL=
VPS_WEBHOOK_SECRET=

# ---- Yalecom (โทรออก + บันทึกเสียง) ----
YALECOM_COMPANY_ID=
YALECOM_KEY=
# ต่อท้าย URL callback ที่ให้ Yalecom (?token=...) กันคนอื่นยิงเข้ามา
YALECOM_CALLBACK_TOKEN=
# secret_key ที่ตกลงกับ Yalecom สำหรับ Sequential playback
YALECOM_PLAYBACK_SECRET=

# ---- ถอดเสียง + จัดผล: ใส่ Gemini หรือ OpenAI อย่างใดอย่างหนึ่ง (มีทั้งคู่ = ใช้ Gemini ก่อน) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
CLASSIFY_MODEL=gpt-4o-mini

# API เว็บเท่าไหร่: GET {VPS_API_URL}/leads และ POST {VPS_API_URL}/results (ส่ง header X-API-Key)
VPS_API_URL=https://thaolai.com/service/api/v1/ai-call
VPS_API_KEY=

# Botnoi Voice: อ่านชื่อคอนโดอัตโนมัติ (token จาก voice.botnoi.ai → Developer / API)
BOTNOI_TOKEN=
BOTNOI_VERSION=v2        # v1 / v2 / v4 / clone (รหัสผู้พูดแต่ละรุ่นไม่ตรงกัน)
BOTNOI_SPEAKER=8         # v2: 8 = Ava · v4: 2 = Ava · v1: 1 = Ava
BOTNOI_SPEED=1
