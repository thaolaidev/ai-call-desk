# ===== SIP Trunk จาก Yalecom =====
# ที่อยู่ SIP server ที่ Yalecom ให้มา
SIP_HOST=3pmbusiness.y4.yalecom.co.th
SIP_PORT=5060
# udp หรือ tcp (Yalecom ใช้ tcp)
SIP_TRANSPORT=tcp
SIP_USER=0828214063
SIP_PASS=
# Yalecom อนุญาตตาม IP (ไม่ต้องลงทะเบียน) → no
SIP_REGISTER=yes
SIP_LOCAL_PORT=5060
# IP สาธารณะของ VPS นี้
PUBLIC_IP=
# เบอร์โทรออก (ถ้า Yalecom ให้ตั้งเอง)
CALLER_ID=0828214063
# บาง trunk ต้องใส่ prefix เช่น PJSIP/9{number}@yalecom
SIP_ENDPOINT=PJSIP/{number}@yalecom

# ===== ภายใน =====
ARI_PASSWORD=เปลี่ยนเป็นรหัสยาวๆ
ARI_URL=http://127.0.0.1:8088
# พอร์ตรับคำสั่งจากเว็บ (เครื่องหลักของเท่าไหร่: 8090 = Jenkins ใช้อยู่ จึงใช้ 8091)
PORT=8091
# ฟังเฉพาะ IP ของ docker network ที่ nginx อยู่ (เข้าจากอินเทอร์เน็ตตรงๆ ไม่ได้)
LISTEN_HOST=172.18.0.1
MAX_CALLS=6

# ===== เชื่อมกับเว็บ ai-call-desk =====
VOICE_SECRET=ตั้งให้ตรงกับ VOICE_SECRET ใน Vercel
WEB_RESULT_URL=https://ai-call-desk.vercel.app/api/voice/result

# ===== ฟังคำตอบ =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# ฟังคำตอบนานสุดกี่วินาที
LISTEN_MAX_SEC=8
# เงียบกี่วินาทีถือว่าตอบจบ
LISTEN_SILENCE_SEC=2
